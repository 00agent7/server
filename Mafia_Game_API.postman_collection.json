  },
  "item": [
    {
      "name": "Game Management",
      "description": "Endpoints for managing game lifecycle",
      "item": [
        {
          "name": "Create Game",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/mafia/games",
              "host": ["{{baseUrl}}"],
              "path": ["api", "mafia", "games"]
            },
            "description": "Creates a new Mafia game"
          },
          "response": [
            {
              "name": "Success Response",
              "originalRequest": {
                "method": "POST",
                "url": {
                  "raw": "{{baseUrl}}/api/mafia/games",
                  "host": ["{{baseUrl}}"],
                  "path": ["api", "mafia", "games"]
                }
              },
              "status": "OK",
              "code": 200,
              "body": "{\n    \"gameId\": \"game123\"\n}"
            }
          ]
        },
        {
          "name": "Get Game",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/mafia/games/{{gameId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "mafia", "games", "{{gameId}}"]
            },
            "description": "Gets a game by ID"
          },
          "response": [
            {
              "name": "Success Response",
              "originalRequest": {
                "method": "GET",
                "url": {
                  "raw": "{{baseUrl}}/api/mafia/games/game123",
                  "host": ["{{baseUrl}}"],
                  "path": ["api", "mafia", "games", "game123"]
                }
              },
              "status": "OK",
              "code": 200,
              "body": "{\n    \"gameId\": \"game123\",\n    \"phase\": \"SETUP\",\n    \"status\": \"ACTIVE\",\n    \"dayCount\": 0,\n    \"nightCount\": 0,\n    \"playerCount\": 10,\n    \"alivePlayerCount\": 10\n}"

            },
            "description": "Gets the current game state with comprehensive information"
          },
          "response": [
            {
              "name": "Success Response",
              "originalRequest": {
                "method": "GET",
                "url": {
                  "raw": "{{baseUrl}}/api/mafia/games/game123/state",
                  "host": ["{{baseUrl}}"],
                  "path": ["api", "mafia", "games", "game123", "state"]
                }
              },
              "status": "OK",
              "code": 200,
              "body": "{\n    \"gameId\": \"game123\",\n    \"phase\": \"DAY\",\n    \"status\": \"ACTIVE\",\n    \"dayCount\": 1,\n    \"nightCount\": 0,\n    \"players\": [\n        {\n            \"seatNumber\": 1,\n            \"alive\": true,\n            \"masked\": false,\n            \"sanctions\": {\n                \"warningCount\": 0,\n                \"removed\": false,\n                \"yellowCard\": false,\n                \"redCard\": false,\n                \"lostNextSpeech\": false\n            }\n        },\n        {\n            \"seatNumber\": 2,\n            \"alive\": true,\n            \"masked\": false,\n            \"sanctions\": {\n                \"warningCount\": 0,\n                \"removed\": false,\n                \"yellowCard\": false,\n                \"redCard\": false,\n                \"lostNextSpeech\": false\n            }\n        }\n    ],\n    \"nominations\": [\n        {\n            \"nominatorSeat\": 1,\n            \"nomineeSeat\": 2,\n            \"voteCount\": 3\n        }\n    ],\n    \"currentSpeaker\": 1\n}"
            }
          ]
        },
        {
          "name": "End Game",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/mafia/games/{{gameId}}/end",
              "host": ["{{baseUrl}}"],
              "path": ["api", "mafia", "games", "{{gameId}}", "end"]
            },
            "description": "Ends a game"
          },
          "response": [
            {
              "name": "Success Response",
              "originalRequest": {
                "method": "POST",
                "url": {
                  "raw": "{{baseUrl}}/api/mafia/games/game123/end",
                  "host": ["{{baseUrl}}"],
                  "path": ["api", "mafia", "games", "game123", "end"]
                }
              },
              "status": "OK",
              "code": 200,
              "body": "{\n    \"status\": \"ended\"\n}"
            }
          ]
        }
      ]
